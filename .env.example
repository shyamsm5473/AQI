# .env.example — copy this to .env and fill in real values
# DO NOT commit .env to version control

# Django secret key — generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True only for local development
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Gmail SMTP credentials
# Generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password

# Database URL — leave blank to use local SQLite (default)
# For PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=sqlite:///db.sqlite3
