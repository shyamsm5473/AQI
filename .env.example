# .env.example — copy this to .env and fill in real values
# DO NOT commit .env to version control!

# ── Django core ─────────────────────────────────────────────────────────────
# Generate a fresh secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key

# Set to True only for local development (defaults to False if omitted)
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Gmail:       smtp.gmail.com   / 587 / True  (needs App Password)
# Outlook/O365: smtp.office365.com / 587 / True
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_password_or_app_password

# ── Database ────────────────────────────────────────────────────────────────
# Leave blank or comment out DB_HOST to use the default local SQLite database.
# For MySQL in production:
# DB_HOST=your_mysql_host
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_PORT=3306
